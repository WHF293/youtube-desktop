{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok",
  "version": "0.1.0",
  "identifier": "com.whf.tiktok",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "TikTok",
        "url": "https://www.tiktok.com/foryou",
        "width": 480,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
